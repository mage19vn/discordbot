# KataBump: Python 3.12, PY FILE=main.py. Điền ít nhất một token.
# Upload requirements.txt cùng main.py; dependencies thiếu được cài trước khi chạy.
TELEGRAM_BOT_TOKEN=
ZALO_BOT_TOKEN=
ZALO_ADMIN_IDS=
# Ảnh: lưu PNG tại máy, upload Cloudinary, lấy URL rồi gửi Zalo.
