MAGOJ_PHOTO_DIR=generated_photos
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=magoj
# Chỉ cần cho MAGOJ_PHOTO_PROVIDER=local với web server HTTPS có sẵn.
MAGOJ_PHOTO_BASE_URL=
TELEGRAM_NOTIFY_CHAT_ID=
MAGOJ_WEBAPP_URL=
TELEGRAM_ADMIN_IDS=
MAGOJ_JUDGE_BACKEND=local
MAGOJ_MAX_JOBS=1
